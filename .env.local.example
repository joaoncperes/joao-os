# Copy this to .env.local after creating the Supabase project.
# Settings → API → Project URL + anon public key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# For local dev. In production, set this to the deployed origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VAPID public key for Web Push. Generate with:
#   pnpm dlx web-push generate-vapid-keys
# Public key goes here (exposed to the browser); private key lives only in
# the cron-worker secrets store.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Blog publishing. Server-only — used by the /blog feature to commit markdown
# to the pedro-blog GitHub repo (which auto-deploys to example.com).
# Fine-grained GitHub PAT, Contents: Read+Write, scoped to ONLY YOUR_USERNAME/YOUR_BLOG.
# In production set it as a Worker secret: `wrangler secret put BLOG_GITHUB_TOKEN`.
BLOG_GITHUB_TOKEN=
# Optional overrides (sensible defaults baked into lib/blog-publish.ts):
# BLOG_REPO=YOUR_USERNAME/YOUR_BLOG
# BLOG_CONTENT_PATH=src/content/articles
# BLOG_DEFAULT_BRANCH=main
