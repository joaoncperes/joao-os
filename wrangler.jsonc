{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joao-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Use the account's CPU allowance so deployment also works on Workers Free.
  // After enabling Workers Paid, a budget can be declared with:
  // "limits": { "cpu_ms": 30000 },
  "workers_dev": true
}
